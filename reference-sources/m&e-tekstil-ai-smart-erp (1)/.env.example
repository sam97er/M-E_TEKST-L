# M&E Tekstil AI Smart ERP - Environment Configuration Template
# Do NOT place real secrets in this file or commit them to source control.

# Application Environment
APP_ENV=development
APP_NAME="M&E Tekstil AI Smart ERP"
HOST=0.0.0.0
PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# Local SQLite Database
DATABASE_URL=sqlite:///./me_tekstil_erp.db

# Security
SECRET_KEY=metekstil_development_secret_key_please_change_in_production

# Trendyol API Credentials (Supplier Partner API)
TRENDYOL_SUPPLIER_ID=YOUR_TRENDYOL_SUPPLIER_ID
TRENDYOL_API_KEY=YOUR_TRENDYOL_API_KEY
TRENDYOL_API_SECRET=YOUR_TRENDYOL_API_SECRET
TRENDYOL_BASE_URL=https://api.trendyol.com/sapigw/suppliers/

# 3 Independent AI Providers Configuration
# Provider 1: Default Primary AI (e.g. Gemini)
AI_PROVIDER_1_ENABLED=true
AI_PROVIDER_1_NAME=gemini
AI_PROVIDER_1_KEY=YOUR_AI_PROVIDER_1_KEY
AI_PROVIDER_1_MODEL=gemini-2.5-flash
AI_PROVIDER_1_BASE_URL=https://generativelanguage.googleapis.com
AI_PROVIDER_1_TASKS=customer_reply,daily_report
AI_PROVIDER_1_TIMEOUT=30

# Provider 2: Secondary / Vision Analysis (e.g. OpenAI or Anthropic)
AI_PROVIDER_2_ENABLED=false
AI_PROVIDER_2_NAME=openai
AI_PROVIDER_2_KEY=YOUR_AI_PROVIDER_2_KEY
AI_PROVIDER_2_MODEL=gpt-4o-mini
AI_PROVIDER_2_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_2_TASKS=image_analysis,stock_audit
AI_PROVIDER_2_TIMEOUT=30

# Provider 3: Fallback / Custom Local LLM
AI_PROVIDER_3_ENABLED=false
AI_PROVIDER_3_NAME=custom_llm
AI_PROVIDER_3_KEY=YOUR_AI_PROVIDER_3_KEY
AI_PROVIDER_3_MODEL=llama-3
AI_PROVIDER_3_BASE_URL=http://localhost:11434/v1
AI_PROVIDER_3_TASKS=pricing_recommendation
AI_PROVIDER_3_TIMEOUT=45

# Telegram Notification Bot
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

